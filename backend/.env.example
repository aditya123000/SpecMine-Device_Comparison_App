PORT=8000
CORS_ORIGIN=http://localhost:5173,https://your-project.vercel.app
JWT_SECRET=replace-with-a-long-random-secret

# Preferred for hosted databases like Supabase / Vercel Postgres:
# DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
#
# Optional local Postgres setup if you are not using DATABASE_URL:
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=compare_devices
# PGUSER=postgres
PGPASSWORD=your_postgres_password

# Use false for local Postgres. Set to true for hosted Postgres providers.
# SSL certificates are verified. Set PG_SSL_CA to a PEM CA certificate if your provider requires a custom CA.
PG_SSL=false
# PG_SSL_CA=

# Optional local development seed from data/db.json when the devices table is empty.
# Defaults to false; production startup seeding is prohibited.
AUTO_SEED_DB=false

# Guard for the destructive seed catalog replacement.
# Set only for a reviewed and approved replacement operation.
SEED_REPLACE_CONFIRM=

# Set to production in deployed environments to reduce error detail in logs.
NODE_ENV=development
